# Copier vers .env (non versionné). Générer le jeton : openssl rand -hex 32
MESLIENS_TOKEN=
DB_URL=jdbc:postgresql://localhost:5432/mesliens
DB_USER=mesliens
DB_PASSWORD=
MESLIENS_REQUIRE_HTTPS=true
# true uniquement derrière un reverse proxy qui contrôle X-Forwarded-For / X-Forwarded-Proto
MESLIENS_TRUST_XFF=false
MESLIENS_SCREENSHOTS_DIR=./data/screenshots
